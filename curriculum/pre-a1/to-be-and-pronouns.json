{
  "id": "pre-a1-to-be-and-pronouns",
  "level": "PRE-A1",
  "unit": "7",
  "order": 1,
  "skill": "grammar",
  "strand": "to-be",
  "title": "Subject Pronouns & To Be — A Slow Start",
  "subtitle": "The words for I, you, he, she — and the three forms of the most important verb in English.",
  "prerequisites": ["pre-a1-basic-verbs-and-wants"],
  "objectives": [
    "Use I, you, he, she, it, we, they correctly",
    "Match each pronoun with the correct form of \"to be\" (am, is, are)",
    "Say simple sentences like \"I am...\", \"She is...\", \"They are...\""
  ],
  "content": {
    "intro": "This lesson goes slowly through something you'll use in almost every English sentence. Take your time — this is the foundation for everything that comes next.",
    "rules": [
      {
        "heading": "Subject pronouns",
        "body": "<ul><li><strong>I</strong> — yourself</li><li><strong>you</strong> — one person or several people you're talking to</li><li><strong>he</strong> — one man/boy &nbsp;|&nbsp; <strong>she</strong> — one woman/girl &nbsp;|&nbsp; <strong>it</strong> — one thing or animal</li><li><strong>we</strong> — you and others &nbsp;|&nbsp; <strong>they</strong> — other people or things</li></ul>"
      },
      {
        "heading": "To be: am, is, are",
        "body": "<div class=\"table-scroll\"><table class=\"ref-table\"><thead><tr><th>Pronoun</th><th>To be</th><th>Example</th></tr></thead><tbody><tr><td>I</td><td>am</td><td>I am happy.</td></tr><tr><td>you</td><td>are</td><td>You are kind.</td></tr><tr><td>he / she / it</td><td>is</td><td>She is a teacher.</td></tr><tr><td>we</td><td>are</td><td>We are friends.</td></tr><tr><td>they</td><td>are</td><td>They are students.</td></tr></tbody></table></div>"
      }
    ],
    "examples": [
      "I am from Brazil.",
      "You are my friend.",
      "He is a doctor.",
      "She is happy today.",
      "It is a nice day.",
      "We are at home.",
      "They are students."
    ],
    "commonMistakes": [
      { "wrong": "I is happy.", "right": "I am happy.", "why": "\"I\" always pairs with \"am\" — never \"is\" or \"are.\"" },
      { "wrong": "She are a teacher.", "right": "She is a teacher.", "why": "\"She\" (like he/it) pairs with \"is,\" not \"are.\"" },
      { "wrong": "They is friends.", "right": "They are friends.", "why": "\"They\" (like we/you) pairs with \"are,\" not \"is.\"" }
    ]
  },
  "exercises": [
    {
      "id": "prea1-tobe-fill", "type": "fill-blank", "title": "Fill in the Blanks",
      "items": [
        { "id": "tb1", "prompt": "I ___ a student.", "answers": [["am"]], "options": ["am", "is", "are"], "explanation": "\"I\" always pairs with \"am.\"" },
        { "id": "tb2", "prompt": "She ___ my sister.", "answers": [["is"]], "options": ["am", "is", "are"], "explanation": "\"She\" pairs with \"is.\"" },
        { "id": "tb3", "prompt": "We ___ friends.", "answers": [["are"]], "options": ["am", "is", "are"], "explanation": "\"We\" pairs with \"are.\"" },
        { "id": "tb4", "prompt": "It ___ a sunny day.", "answers": [["is"]], "options": ["am", "is", "are"], "explanation": "\"It\" pairs with \"is.\"" },
        { "id": "tb5", "prompt": "They ___ at school.", "answers": [["are"]], "options": ["am", "is", "are"], "explanation": "\"They\" pairs with \"are.\"" }
      ]
    },
    {
      "id": "prea1-tobe-match", "type": "matching", "title": "Match the Pronoun to Its Form of To Be",
      "items": [
        { "id": "tb6", "pairs": [
          { "left": "I", "right": "am" },
          { "left": "You", "right": "are" },
          { "left": "He", "right": "is" },
          { "left": "We", "right": "are" },
          { "left": "It", "right": "is" }
        ], "explanation": "Am goes only with I; is goes with he/she/it; are goes with you/we/they." }
      ]
    },
    {
      "id": "prea1-tobe-order", "type": "ordering", "title": "Put the Words in Order",
      "items": [
        { "id": "tb7", "prompt": "happy / am / I", "words": ["I", "am", "happy"], "explanation": "Subject + am + adjective." },
        { "id": "tb8", "prompt": "teacher / is / she / a", "words": ["She", "is", "a", "teacher"], "explanation": "Subject + is + article + noun." },
        { "id": "tb9", "prompt": "students / are / they", "words": ["They", "are", "students"], "explanation": "Subject + are + noun." }
      ]
    }
  ],
  "summary": [
    "I → am. He/She/It → is. You/We/They → are.",
    "This is the foundation for almost every sentence you'll build in English — practice it until it's automatic.",
    "Next, in A1, you'll build on this with negatives, questions, and much more."
  ],
  "related": [],
